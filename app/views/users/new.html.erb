<h1>Crear cuenta</h1>

<div class="auth-container">

  <% if @user.errors.any? %>
    <div class="errors">
      <h3>No se pudo crear la cuenta:</h3>

      <ul>
        <% @user.errors.full_messages.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, class: "auth-form" do |form| %>

    <div class="form-group">
      <%= form.label :name, "Nombre" %>
      <%= form.text_field :name, placeholder: "Tu nombre", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :email, "Email" %>
      <%= form.email_field :email, placeholder: "ejemplo@gmail.com", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :password, "Contraseña" %>
      <%= form.password_field :password, placeholder: "Mínimo 4 caracteres", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :password_confirmation, "Confirmar contraseña" %>
      <%= form.password_field :password_confirmation, class: "form-input" %>
    </div>

    <%= form.submit "Registrarse", class: "submit-button" %>

  <% end %>

</div>