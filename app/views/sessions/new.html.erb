<h1>Iniciar sesión</h1>

<% if flash[:alert] %>
  <div class="errors">
    <%= flash[:alert] %>
  </div>
<% end %>

<div class="auth-container">

  <%= form_with url: login_path, class: "auth-form" do |form| %>

    <div class="form-group">
      <%= form.label :email, "Correo electrónico" %>
      <%= form.email_field :email, placeholder: "ejemplo@gmail.com", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :password, "Contraseña" %>
      <%= form.password_field :password, placeholder: "Ingresá tu contraseña", class: "form-input" %>
    </div>

    <%= form.submit "Ingresar", class: "submit-button" %>

  <% end %>

</div>